# Root-level safety net — backend/ and frontend/ each carry their own more
# specific .gitignore; these patterns catch anything at the repo root itself.

.env
.env.*
!.env.example

.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# Private integration credential files
**/google-service-account*.json
**/service-account*.json
backend/storage/app/private/google-sheets/
backend/storage/app/private/google/

# Local AI-assistant tool state — not app code, and the permission
# allowlists below have carried real local DB credentials in past commands.
.claude/
.commandcode/

# Local deployment build output (zips, extracted bundles) — regenerated by
# deploy/build.sh, not source; can run into the hundreds of MB.
deploy/output/

# Local task/notes scratch files — not part of the app.
/DP.md

# Local pre-change database dumps (e.g. before a transaction reset/cleanup) —
# operational recovery artifacts that can contain real production data, never
# app source; see docs/TRANSACTION-RESET-REPORT.md.
/backups/
