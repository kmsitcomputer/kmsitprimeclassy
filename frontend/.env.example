# Local dev: leave EMPTY so the SPA talks to its own origin. Vite proxies
# /api, /sanctum and /up to the backend below (see vite.config.ts), mirroring
# the single-domain production layout exactly — no CORS, same-origin cookies.
VITE_API_URL=

# Where the Vite dev server forwards /api, /sanctum and /up — i.e. the Laravel
# app. Must match SANCTUM_STATEFUL_DOMAINS/FRONTEND_URLS in backend/.env.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Optional: powers the checkout address map picker (click/drag a pin,
# search-by-place autocomplete) — available regardless of shipping method,
# alongside (never replacing) the plain "Gunakan Lokasi Sekarang" browser-
# geolocation button. Leave empty to keep only that fallback.
#
# Google Maps JS API keys are meant to be client-visible — this is not a
# backend secret — but MUST be restricted in Google Cloud Console before
# going to production:
#   - HTTP referrer restriction: only your real domain(s), e.g.
#     https://primeclassy.com/*, https://www.primeclassy.com/*
#     (add localhost/your dev origin separately for local development).
#   - API restriction: enable ONLY "Maps JavaScript API" and "Places API" —
#     nothing else is used (no Geocoding API; reverse-geocoding on marker
#     move is not implemented). Never ship an unrestricted key.
VITE_GOOGLE_MAPS_API_KEY=
