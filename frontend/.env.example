# Local dev: leave EMPTY so the SPA talks to its own origin. Vite proxies
# /api, /sanctum and /up to the backend below (see vite.config.ts), mirroring
# the single-domain production layout exactly — no CORS, same-origin cookies.
VITE_API_URL=

# Where the Vite dev server forwards /api, /sanctum and /up — i.e. the Laravel
# app. Must match SANCTUM_STATEFUL_DOMAINS/FRONTEND_URLS in backend/.env.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Optional: only used for the checkout address map picker/autocomplete, and
# only rendered when OpenRoute is active (see GET /checkout/steps
# map_picker_enabled). Google Maps JS API keys are meant to be client-visible
# (restrict it by HTTP referrer in Google Cloud Console) — this is not a
# backend secret. Leave empty to keep the plain "use my location" fallback.
VITE_GOOGLE_MAPS_API_KEY=
