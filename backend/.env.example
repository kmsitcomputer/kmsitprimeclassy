# PrimeClassy Go API — environment template.
#
# Copy to `.env` (gitignored) for local work; in a container/unit, set the same keys as environment variables.

# --- application -----------------------------------------------------------------------------------
APP_ENV=local                 # local | testing | staging | production
APP_URL=http://primeclassy-go-local.kmsit.localhost # browser-facing origin; used to build /storage asset URLs
HTTP_ADDR=:8082

# --- database (existing PrimeClassy MariaDB schema) ------------------------------------------------
DB_HOST=primeclassy-mariadb
DB_PORT=3306
DB_DATABASE=primeclassy_go_local
DB_USERNAME=primeclassy_app
DB_PASSWORD=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# --- session / CSRF --------------------------------------------------------------------------------
# NOTE: SESSION_COOKIE must NOT be laravel_session. Go sessions are stored in pc_go_sessions and are not
# PHP-serialised, so one runtime must never invalidate the other's session rows. The browser contract is
# unchanged: HttpOnly session cookie + readable XSRF-TOKEN cookie + X-XSRF-TOKEN header.
SESSION_COOKIE=pc_sid_local
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
# Only these origins may make credentialed cross-site calls (CORS echoes exactly these).
SANCTUM_STATEFUL_DOMAINS=primeclassy-go-local.kmsit.localhost,localhost:5173

# --- http ------------------------------------------------------------------------------------------
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_BODY_BYTES=1048576
TRUST_PROXY_HEADERS=true

# --- observability ---------------------------------------------------------------------------------
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=json               # json | text

# --- installer marker ------------------------------------------------------------------------------
# Imported installation marker inside the unified storage root.
INSTALL_LOCK_PATH=/srv/storage/installed.lock
MEDIA_ROOT=/srv/storage/public
STORAGE_ROOT=/srv/storage
