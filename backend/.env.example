APP_NAME="Prime Classy Cake & Cookies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Sanctum SPA session auth REQUIRES this — the list of host:port origins
# (no scheme, comma-separated) allowed to receive a stateful session.
# Without it, every authenticated request fails with "Session store not set
# on request." The app is served from a SINGLE domain, so this is just that
# one host: SANCTUM_STATEFUL_DOMAINS=yourdomain.com for production, or
# SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173 for local dev.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=primeclassy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Single-origin app: leave SESSION_DOMAIN unset (host-only cookie). It only
# ever needed a value for the legacy separate-subdomain layout, which is no
# longer supported.
# SESSION_DOMAIN=

# Session cookie policy. Production (HTTPS, single origin): leave
# SESSION_SECURE_COOKIE=true and the default SESSION_SAME_SITE=lax. Local dev
# over plain http://localhost must turn Secure off or the browser drops the
# cookie:
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional: real road-distance shipping fee calculation. Leave empty to keep
# using the built-in Haversine straight-line distance.
OPENROUTE_API_KEY=
OPENROUTE_BASE_URL=https://api.openrouteservice.org

# Comma-separated list of origins allowed to make credentialed
# (cookie-session) requests — see config/cors.php. Single-origin deploys
# list just the one app URL (same-origin requests don't invoke CORS at all,
# but Sanctum still validates the origin). Exact URL, no trailing slash.
FRONTEND_URLS=http://localhost:5173

# Central service account JSON must be outside the public directory and Git.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_CREDENTIALS_PATH=
