# PrimeClassy Go API — environment template.
#
# The keys intentionally mirror the Laravel `.env` so one runbook covers both runtimes. Copy to `.env`
# (gitignored) for local work; in a container/unit, set the same keys as real environment variables.

# --- application -----------------------------------------------------------------------------------
APP_ENV=local                 # local | testing | staging | production
APP_URL=http://localhost:8080 # browser-facing origin; used to build /storage asset URLs
HTTP_ADDR=:8081

# --- database (MySQL/MariaDB, the existing schema owned by the Laravel migrations) ------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=primeclassy_db
DB_USERNAME=primeclassy_app
DB_PASSWORD=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# --- session / CSRF --------------------------------------------------------------------------------
# NOTE: SESSION_COOKIE must NOT be laravel_session. Go sessions are stored in pc_go_sessions and are not
# PHP-serialised, so one runtime must never invalidate the other's session rows. The browser contract is
# unchanged: HttpOnly session cookie + readable XSRF-TOKEN cookie + X-XSRF-TOKEN header.
SESSION_COOKIE=pc_sid
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
# Only these origins may make credentialed cross-site calls (CORS echoes exactly these).
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1:5173

# --- http ------------------------------------------------------------------------------------------
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_BODY_BYTES=1048576
TRUST_PROXY_HEADERS=true

# --- observability ---------------------------------------------------------------------------------
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=json               # json | text

# --- installer marker ------------------------------------------------------------------------------
# Optional. Defaults to ../backend/storage/app/installed.lock, the same file Laravel's InstallLock writes, so
# GET /api/v1/install/status agrees across runtimes.
# INSTALL_LOCK_PATH=/srv/primeclassy/backend/storage/app/installed.lock
