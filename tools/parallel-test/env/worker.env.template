# Per-worker environment TEMPLATE (rendered in memory by pctest/plan.py; nothing here is auto-applied).
# Placeholders: {N} worker index, {DB_NAME}, {DB_HOST}, {DB_PORT}, {DB_USERNAME}, {WORKER_DIR}, {RUN_ID}, {RUN_UUID}
# DB_PASSWORD is deliberately absent: it is injected at Stage B from PC_TEST_DB_PASSWORD or .env.testing
# (read-only, in memory, never logged, never written to artifacts).
APP_ENV=testing
DB_CONNECTION=mysql
DB_HOST={DB_HOST}
DB_PORT={DB_PORT}
DB_DATABASE={DB_NAME}
DB_USERNAME={DB_USERNAME}
# Connection-override neutralisation (F01): blank values WIN over anything inherited from the container or .env files.
DB_URL=
DATABASE_URL=
DB_SOCKET=
LARAVEL_STORAGE_PATH={WORKER_DIR}/storage
TMPDIR={WORKER_DIR}/tmp
PRIMECLASSY_TEST_RUN_ID={RUN_UUID}
PRIMECLASSY_PARALLEL_WORKER={N}
PRIMECLASSY_PARALLEL_WORKER_DB={DB_NAME}
CACHE_STORE=array
CACHE_PREFIX=pcw{N}_
SESSION_DRIVER=array
SESSION_COOKIE=pcw{N}_session
QUEUE_CONNECTION=sync
REDIS_PREFIX=pcw{N}_
MAIL_MAILER=array
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
# Laravel bootstrap cache isolation (F05): Application::getCached*Path() honours these (Env::get) and falls back to backend/bootstrap/cache otherwise.
APP_SERVICES_CACHE={WORKER_DIR}/bootstrap-cache/services.php
APP_PACKAGES_CACHE={WORKER_DIR}/bootstrap-cache/packages.php
APP_CONFIG_CACHE={WORKER_DIR}/bootstrap-cache/config.php
APP_ROUTES_CACHE={WORKER_DIR}/bootstrap-cache/routes-v7.php
APP_EVENTS_CACHE={WORKER_DIR}/bootstrap-cache/events.php
