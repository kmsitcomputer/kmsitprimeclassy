# Single-domain deployment: frontend (SPA) and backend (Laravel API) share
# one document root. This decides, per request, which of the three wins:
#   1. /api/*, /sanctum/*, /up  -> Laravel (laravel.php), REQUEST_URI kept intact
#   2. a real file/directory (built JS/CSS, config.js, favicon.ico, storage/) -> served as-is
#   3. anything else (a client-side Vue Router path) -> index.html (the SPA shell)

# Never let LiteSpeed's page cache (LSCache — often enabled by default on
# shared hosting) cache anything dynamic: a cached /sanctum/csrf-cookie
# response hands out a stale session/token pair to every later visitor,
# which surfaces as a "CSRF token mismatch" that no amount of retrying can
# fix (the request just gets served the same cached response again). The
# app also sends Cache-Control/X-LiteSpeed-Cache-Control: no-cache on every
# response itself (defense in depth) — this stops the cache before PHP even
# runs, for the paths that matter most.
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} ^/(api|sanctum|up)(/|$)
  RewriteRule ^ - [E=Cache-Control:no-cache]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Laravel's own routes (never SPA-fallback these, and never require a real
  # file to exist on disk for them — they're all handled by PHP).
  RewriteCond %{REQUEST_URI} ^/(api|sanctum|up)(/|$)
  RewriteRule ^ laravel.php [L]

  # Real files and directories served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls back to the SPA shell.
  RewriteRule ^ index.html [L]
</IfModule>

# PWA: correct MIME for the web app manifest (Apache may otherwise serve
# .webmanifest as text/plain, which breaks installability checks).
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# PWA cache lifetimes: the service worker, manifest, shell, and runtime
# config are file names that NEVER change between builds, so they must be
# revalidated on every load — never long-lived immutable.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest|index\.html|config\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Hashed build assets under /assets/* are content-addressed (a new build
# emits new file names), so they are safe to cache for a year. Icons are
# deliberately excluded so replacement artwork is picked up promptly.
<IfVersion >= 2.4>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    <IfModule mod_headers.c>
      Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
  </If>
</IfVersion>
